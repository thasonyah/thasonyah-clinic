POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=replace-with-generated-local-password
DATABASE_URL=postgresql+psycopg://clinic:replace-with-generated-local-password@localhost:5432/clinic
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:5173"]
# Render static build uses this public URL, not a secret:
VITE_API_BASE_URL=/api/v1
# Authentication: access sessions expire after this many minutes (1–60).
ACCESS_TOKEN_MINUTES=30
# One-time setup only; leave blank until creating the first admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Email password recovery (disabled until configured).
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Fixed HTTPS frontend URL, for example https://clinic.example/staff
RESET_PUBLIC_URL=
